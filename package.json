{
  "name": "cobro-mcp",
  "version": "0.6.1",
  "description": "Co-browse for coding agents: pick elements in the browser, write a note, Send — the context lands in the agent's chat. MCP server with 6 tools.",
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "cursor",
    "codex",
    "browser",
    "overlay",
    "co-browse",
    "ui-feedback",
    "playwright"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cobro-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.ko.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "fixtures:install": "node scripts/install-fixtures.mjs",
    "e2e": "npm run build && npm run fixtures:install && playwright test",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.50.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "eslint": "^9.10.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boonblade/cobro-mcp.git"
  },
  "homepage": "https://github.com/boonblade/cobro-mcp#readme",
  "bugs": {
    "url": "https://github.com/boonblade/cobro-mcp/issues"
  }
}
